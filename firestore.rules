rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Usernames: 3-20 letters, digits, "_" or "." (same rule as WelcomeScreen), and the
    // search key is always the lower-cased name. ASCII only, so the app's lower-casing and
    // this one can never disagree.
    function validUsername(name) {
      return name is string && name.matches('[A-Za-z0-9_.]{3,20}');
    }

    function validToken(token) {
      return token is string && token.size() <= 4096;
    }

    // The caller's own stored username: names copied onto doodles and requests must
    // match it, so nobody can send under someone else's name.
    function myUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    match /users/{userId} {
      // Readable by any signed-in user: username search needs it.
      allow read: if signedIn();

      // Owner only, known fields only. Username fields are validated whenever they're
      // written, so token refreshes on older accounts keep working.
      // fcmToken is still allowed here until it moves to a private document (Phase 2).
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'fcmToken'])
        && request.resource.data.uid == userId
        && validUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && (!('fcmToken' in request.resource.data) || validToken(request.resource.data.fcmToken));
      // Update limits which fields may CHANGE (not the whole doc), so a profile written
      // by an older app version with an extra field can still refresh its token.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid', 'username', 'usernameLower', 'fcmToken'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
          || request.resource.data.uid == userId)
        // A new name must pass the rule. Older profiles with no search key may add one
        // for their existing name, even if that name predates the rule.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
          || validUsername(request.resource.data.username))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'usernameLower'])
          || request.resource.data.usernameLower == request.resource.data.username.lower())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmToken'])
          || validToken(request.resource.data.fcmToken));
      allow delete: if false;

      // Who I've muted. Owner-only, so a muted friend can never find out.
      // The Cloud Function reads this with admin privileges.
      match /mutes/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Doodles I've starred in the Vault. Owner-only, like mutes.
      match /favorites/{doodleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // The other person's name copied onto a doodle or request (shown only to the sender).
    // Generous bound: some older usernames predate the 20-character rule.
    function otherName(name) {
      return name is string && name.size() <= 200;
    }

    // Note: "a == me || b == me" (not "me in [a, b]") lets Firestore prove list queries
    // filtered on either field, e.g. receiverId == me. Same meaning for single reads.

    // Friend requests: sent as yourself, to someone else, always "pending". Only the two
    // people involved can see it; either can delete it (decline, or tidy up after accept).
    match /friend_requests/{requestId} {
      allow read, delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'fromUsername', 'toUid', 'toUsername', 'status', 'timestamp'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid.size() > 0
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromUsername == myUsername()
        && otherName(request.resource.data.toUsername)
        && request.resource.data.status == 'pending'
        && request.resource.data.timestamp is number;
      allow update: if false;
    }

    // Friendships: only the two friends can see one. A new friendship must be created by
    // the person accepting (userA), and must name a real pending request that userB sent
    // to them. get() sees the request as it was before the write; existsAfter() requires
    // that same write to delete it, so one request makes exactly one friendship.
    match /friendships/{friendshipId} {
      allow read, delete: if signedIn()
        && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userA', 'userB', 'createdAt', 'requestId'])
        && request.resource.data.userA == request.auth.uid
        && request.resource.data.userB is string
        && request.resource.data.userB != request.auth.uid
        && request.resource.data.createdAt is number
        && request.resource.data.requestId is string
        && request.resource.data.requestId.matches('[A-Za-z0-9]{1,40}')
        && !existsAfter(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId))
        && exists(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.fromUid == request.resource.data.userB
        && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.toUid == request.auth.uid
        && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.status == 'pending';
      allow update: if false;
    }

    // Doodles and flash cards: only the sender and receiver can see one. Sent as yourself,
    // to someone else, "unseen", with a bounded drawing or a known card id. Afterwards
    // the receiver may only mark it "removed"; nobody can edit the content or delete it.
    // Limitation: friendship can't be checked here (random friendship ids); the push
    // function checks it, so a non-friend's doodle never pops up (it can still appear in
    // the receiver's Vault list until Block / deterministic friendship ids land).
    match /doodles/{doodleId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderId', 'senderUsername', 'receiverId', 'receiverUsername', 'strokes', 'createdAt', 'status', 'cardId'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId.size() > 0
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.senderUsername == myUsername()
        && otherName(request.resource.data.receiverUsername)
        && request.resource.data.strokes is list
        && request.resource.data.strokes.size() <= 500
        && request.resource.data.createdAt is number
        && request.resource.data.status == 'unseen'
        && (!('cardId' in request.resource.data)
          || (request.resource.data.cardId is string && request.resource.data.cardId.matches('card[0-9]{2}')));
      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'removed';
      allow delete: if false;
    }

    // (The old connection_test collection is gone: anything not matched here is denied.)

    // 1:1 chats. chatId is the two member uids, sorted and joined with "_".
    // Limitation: friendship can't be checked here (friendships have random doc ids,
    // so there's no path to get()); the app only offers chat between friends.
    match /chats/{chatId} {
      function chatKeys() {
        return ['members', 'theme', 'lastMessage', 'lastSenderId', 'lastAt', 'lastRead'];
      }

      // Members are fixed at create and can never change, so membership can be read
      // off the id itself. That also works before the chat doc exists (opening a chat
      // nobody has written in yet) and costs no extra document read.
      function idHasMember() {
        return chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_');
      }

      // Single-doc read: a member, or (doc not created yet) one of the two uids in the id.
      allow get: if request.auth != null
        && ((resource == null && idHasMember())
          || (resource != null && request.auth.uid in resource.data.members));
      // Queries must filter on members array-contains my uid.
      allow list: if request.auth != null && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(chatKeys())
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && (!('theme' in request.resource.data)
          || (request.resource.data.theme is string && request.resource.data.theme.size() <= 32))
        && (!('lastMessage' in request.resource.data)
          || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 120))
        && (!('lastSenderId' in request.resource.data) || request.resource.data.lastSenderId == request.auth.uid)
        && (!('lastAt' in request.resource.data) || request.resource.data.lastAt == request.time)
        && (!('lastRead' in request.resource.data)
          || (request.resource.data.lastRead is map
            && request.resource.data.lastRead.keys().hasOnly([request.auth.uid])));

      // Members only; members never change; only the known keys. Whoever changes the
      // preview or its time must be its sender (lastAt at server time), and in lastRead
      // only the caller's own read receipt may change.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(chatKeys())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['theme'])
          || (request.resource.data.theme is string && request.resource.data.theme.size() <= 32))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
          || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 120))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastSenderId', 'lastAt'])
          || request.resource.data.lastSenderId == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastAt'])
          || request.resource.data.lastAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastRead'])
          || (request.resource.data.lastRead is map
            && request.resource.data.lastRead.diff(resource.data.get('lastRead', {}))
              .affectedKeys().hasOnly([request.auth.uid])));

      allow delete: if false;

      match /messages/{messageId} {
        // Same id-based membership as the chat doc (see idHasMember above), so the
        // listener works before the first message creates the chat.
        allow read: if request.auth != null
          && chatId.split('_').size() == 2
          && request.auth.uid in chatId.split('_');
        // getAfter: in the first-message batch the chat doc is created in the same
        // commit, so a plain get() wouldn't see it yet.
        allow create: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['senderId', 'kind', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in ['text', 'theme']
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
