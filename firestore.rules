rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Who I've muted. Owner-only, so a muted friend can never find out.
      // The Cloud Function reads this with admin privileges.
      match /mutes/{friendUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Doodles I've starred in the Vault. Owner-only, like mutes.
      match /favorites/{doodleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }
    match /friendships/{friendshipId} {
      allow read, write: if request.auth != null;
    }
    match /doodles/{doodleId} {
      allow read, write: if request.auth != null;
    }
    match /connection_test/{docId} {
      allow read, write: if request.auth != null;
    }

    // 1:1 chats. chatId is the two member uids, sorted and joined with "_".
    // Limitation: friendship can't be checked here (friendships have random doc ids,
    // so there's no path to get()); the app only offers chat between friends.
    match /chats/{chatId} {
      function chatKeys() {
        return ['members', 'theme', 'lastMessage', 'lastSenderId', 'lastAt', 'lastRead'];
      }

      // Members are fixed at create and can never change, so membership can be read
      // off the id itself. That also works before the chat doc exists (opening a chat
      // nobody has written in yet) and costs no extra document read.
      function idHasMember() {
        return chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_');
      }

      // Single-doc read: a member, or (doc not created yet) one of the two uids in the id.
      allow get: if request.auth != null
        && ((resource == null && idHasMember())
          || (resource != null && request.auth.uid in resource.data.members));
      // Queries must filter on members array-contains my uid.
      allow list: if request.auth != null && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(chatKeys())
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && (!('theme' in request.resource.data)
          || (request.resource.data.theme is string && request.resource.data.theme.size() <= 32))
        && (!('lastMessage' in request.resource.data)
          || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 120))
        && (!('lastSenderId' in request.resource.data) || request.resource.data.lastSenderId == request.auth.uid)
        && (!('lastAt' in request.resource.data) || request.resource.data.lastAt == request.time)
        && (!('lastRead' in request.resource.data)
          || (request.resource.data.lastRead is map
            && request.resource.data.lastRead.keys().hasOnly([request.auth.uid])));

      // Members only; members never change; only the known keys. Whoever changes the
      // preview or its time must be its sender (lastAt at server time), and in lastRead
      // only the caller's own read receipt may change.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(chatKeys())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['theme'])
          || (request.resource.data.theme is string && request.resource.data.theme.size() <= 32))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
          || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 120))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastSenderId', 'lastAt'])
          || request.resource.data.lastSenderId == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastAt'])
          || request.resource.data.lastAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastRead'])
          || (request.resource.data.lastRead is map
            && request.resource.data.lastRead.diff(resource.data.get('lastRead', {}))
              .affectedKeys().hasOnly([request.auth.uid])));

      allow delete: if false;

      match /messages/{messageId} {
        // Same id-based membership as the chat doc (see idHasMember above), so the
        // listener works before the first message creates the chat.
        allow read: if request.auth != null
          && chatId.split('_').size() == 2
          && request.auth.uid in chatId.split('_');
        // getAfter: in the first-message batch the chat doc is created in the same
        // commit, so a plain get() wouldn't see it yet.
        allow create: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['senderId', 'kind', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in ['text', 'theme']
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
